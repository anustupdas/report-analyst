# Secrets only. Non-secret settings live in apps/*/configs/staging/config.yml.
# Copy to .env. Docker Compose passes this one file to every container.
# `make run` still reads the per-app .env files as well.
POSTGRES_USER=chat
POSTGRES_PASSWORD=chat

# Host folder mounted as /data in the API and text-extraction containers.
# Relative paths are from the repo root. Point this at an existing data directory.
DATA_DIR=./data

# Required for chat and the document description. Also required when
# EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=

# Text extraction. false = PyMuPDF. true = Mistral OCR, which needs MISTRAL_API_KEY.
TEXT_EXTRACTION_USE_OCR=false
MISTRAL_API_KEY=

# Embeddings. openai (text-embedding-3-small, 1536) or huggingface (gte, 768).
# Switching this does not rewrite vectors already stored. Re-process those reports.
EMBEDDING_PROVIDER=openai

# Shared by the API and LangGraph. Chat and datapoints fail if this is empty.
AGENT_SECRET=dev-agent-secret-change-me

# Optional. Leave empty to use the prompts shipped in the repo.
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
