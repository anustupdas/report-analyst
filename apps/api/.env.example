# Secrets only. Non-secret settings live in configs/staging/config.yml.
# Postgres credentials come from the repo-root .env (set POSTGRES_USER / POSTGRES_PASSWORD
# or a full DATABASE_URL here to override).

# Required by the agent / internal workflow routes outside development
AGENT_SECRET=dev-agent-secret-change-me
INTERNAL_WORKFLOW_SECRET=dev-internal-secret-change-me

# Document description (company, year, summary) via OpenAI; empty = step skipped
OPENAI_API_KEY=

# Langfuse (prompt management + tracing). Host can also be LANGFUSE_BASE_URL.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=
