# Secrets only. Non-secret settings live in configs/staging/config.yml.
# Postgres credentials come from the repo-root .env unless overridden here.

AGENT_SECRET=dev-agent-secret-change-me
# Leave empty to inherit OPENAI_API_KEY from apps/api/.env
OPENAI_API_KEY=

# Langfuse (prompt management + tracing). Leave empty to inherit from apps/api/.env.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=
